# Copy to .env on local / VPS / VSCode. Cloud hosts set these as dashboard secrets.
# Never commit real cookies or tokens.

# Single-account AppState JSON (Render/Railway secret ACCOUNT_TXT writes account.txt)
ACCOUNT_TXT=

# Public HTTP port (Render/Railway inject this automatically)
PORT=8080

# Keep the public health endpoint awake
ALIYA_SELF_PING=1

# Optional: disable the public dashboard proxy and let the bot own PORT directly
# ALIYA_NO_PROXY=1

# Optional: public URL for self-ping (auto-detected on Render/Railway/Replit)
# ALIYA_SELF_URL=

# Optional memory cap for the supervisor/child (MB)
# ALIYA_MAX_MEM_MB=512
